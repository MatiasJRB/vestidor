# Generate via: printf '%s' 'a-long-secret-passphrase' | npm run --silent password:hash
ADMIN_PASSWORD_HASH=
DATA_DIR=./data
PORT=4180
# Exact HTTPS origin for hosted mutations. Local dev uses its http origin.
PUBLIC_ORIGIN=
# Optional: your own OAuth Web application for hosted Google Photos Picker.
GOOGLE_PHOTOS_OAUTH_FILE=
GOOGLE_PHOTOS_REDIRECT_URI=
