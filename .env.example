# Generate via: printf '%s' 'a-long-secret-passphrase' | npm run --silent password:hash
ADMIN_PASSWORD_HASH=
DATA_DIR=./data
PORT=4180
# Exact HTTPS origin for hosted mutations. Local dev uses its http origin.
PUBLIC_ORIGIN=
# Optional: your own OAuth Web application for hosted Google Photos Picker.
GOOGLE_PHOTOS_OAUTH_FILE=
GOOGLE_PHOTOS_REDIRECT_URI=

# Vercel cloud edition (all server-only; never prefix with VITE_)
# Use google on Vercel; local self-hosting defaults to password.
AUTH_MODE=password
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_GOOGLE_EMAIL=
# Google callback must be PUBLIC_ORIGIN + /auth/google/callback
BLOB_READ_WRITE_TOKEN=
