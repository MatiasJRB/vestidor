{
  "name": "vestidor",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local --import tsx server/app.ts --dev",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check": "tsc -b --pretty false",
    "test": "node --import tsx --test server/*.test.ts",
    "setup:google-photos": "node scripts/setup-google-photos.mjs",
    "catalog:queue": "node scripts/catalog-image-queue.mjs list",
    "catalog:claim": "node scripts/catalog-image-queue.mjs claim",
    "start": "node --env-file-if-exists=.env.local --import tsx server/app.ts",
    "password:hash": "tsx scripts/password-hash.ts",
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "latest",
    "@vercel/blob": "^2.8.2",
    "jose": "^6.2.12",
    "react": "latest",
    "react-dom": "latest",
    "tsx": "^4.20.0",
    "sharp": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  }
}
